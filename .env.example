# Stylevique Server — environment variable names only.
# Copy this file to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=stylevique
AUTH_USER_COLLECTION=user

# Client URLs (comma separated allowed; first one is the primary origin)
CLIENT_URL=http://localhost:3000

# Better Auth JWT verification (defaults derive from CLIENT_URL)
BETTER_AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
BETTER_AUTH_ISSUER=http://localhost:3000
BETTER_AUTH_AUDIENCE=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=usd

# ImgBB (image hosting)
IMGBB_API_KEY=xxx

# Admin CLI (npm run promote-admin)
ADMIN_EMAIL=admin@example.com

# Uploads
MAX_UPLOAD_SIZE_MB=5
